# Supabase — Settings → API 에서 확인
# (구버전 프로젝트라면 publishable = anon key, secret = service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# YouTube Data API v3 키 — Google Cloud Console 에서 발급
YOUTUBE_API_KEY=

# /api/cron/refresh 호출 인증용. 아무 긴 임의 문자열이면 됩니다.
# GitHub Actions 의 CRON_SECRET 시크릿과 반드시 같은 값이어야 합니다.
CRON_SECRET=

# 사이트 접속 비밀번호. 비워두면 로그인 게이트가 꺼집니다(로컬 개발 시 편함).
APP_PASSWORD=

# 한 번의 수집 실행이 쓸 수 있는 초. 호스트의 함수 타임아웃보다 낮아야 합니다.
# Vercel Hobby(60초 제한) 기준 기본값 50. Pro 이상이면 250 정도까지 올려도 됩니다.
CRON_BUDGET_SECONDS=50
